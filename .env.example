# Cron authentication secret
CRON_SECRET=
# Postgres connection string (Neon). Vercel sets this automatically
# when the Neon integration is connected to the project.
DATABASE_URL=

# Gemini API Key
VITE_GEMINI_API_KEY=

# SMTP alert email config
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
# Optional. Defaults to SMTP_FROM_EMAIL if omitted.
ALERTS_TO_EMAIL=
